# ─── MCP Server Registration ───────────────────────────────────────────────────

def register_wind_tools(server) -> None:
    """
    将所有 Wind 金融数据 tools 注册到 MCP server。

    Args:
        server: MCP server 实例，需要支持 @server.tool() 装饰器或类似注册机制。
    """
    for tool_def in WIND_TOOLS:
        tool_name = tool_def["name"]
        tool_handler = tool_def["handler"]
        tool_description = tool_def["description"]
        tool_schema = tool_def["inputSchema"]

        # 尝试多种注册方式以兼容不同的 MCP server 实现
        if hasattr(server, "tool"):
            # FastMCP 风格: @server.tool()
            decorated = server.tool(
                name=tool_name,
                description=tool_description,
            )(tool_handler)
        elif hasattr(server, "register_tool"):
            # 通用注册接口
            server.register_tool(
                name=tool_name,
                description=tool_description,
                input_schema=tool_schema,
                handler=tool_handler,
            )
        elif hasattr(server, "add_tool"):
            # 另一种注册接口
            server.add_tool(
                name=tool_name,
                description=tool_description,
                input_schema=tool_schema,
                handler=tool_handler,
            )
        else:
            # 回退: 直接设置属性
            setattr(server, f"_tool_{tool_name}", tool_handler)


# ─── Standalone Server (when run directly) ─────────────────────────────────────

def main():
    """独立运行模式 - 启动 MCP Server。"""
    try:
        from mcp.server.fastmcp import FastMCP
    except ImportError:
        print("错误: 需要安装 mcp 包。请运行: pip install mcp")
        print("或使用 uv: uv pip install mcp")
        return

    mcp_server = FastMCP(
        "Wind Financial Data",
        instructions="万得金融数据 MCP Server - 提供股票行情、财务数据、估值指标、行业数据、宏观经济、财经新闻等数据服务"
    )

    # 注册所有 tools
    register_wind_tools(mcp_server)

    print("Wind MCP Server 已启动")
    print(f"API URL: {WIND_API_URL}")
    api_key = _get_api_key()
    if api_key:
        masked = api_key[:8] + "..." + api_key[-4:] if len(api_key) > 12 else "***"
        print(f"API Key: {masked}")
    else:
        print("警告: 未找到 API Key，请设置 WIND_API_KEY 环境变量或配置 ~/.wind-aifinmarket/config")
    print("Tools: " + ", ".join(t["name"] for t in WIND_TOOLS))

    mcp_server.run()


if __name__ == "__main__":
    main()
